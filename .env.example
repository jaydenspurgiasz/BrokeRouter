# Copy this file to .env. Every .env* file except this example is ignored by Git.
# Keep each account definition on one line. The binding suffix becomes its default
# credential scope, so PRIMARY and BACKUP have completely separate quota/cooldown state.

# Router caller credential (development-only fallback).
ROUTER_API_KEY=replace-with-a-long-random-caller-key

# One OpenAI-compatible provider account. Replace the endpoint, model facts, limits,
# and placeholder token with values from the provider's current documentation/dashboard.
BROKEROUTER_PROVIDER_ACCOUNT_GROQ_PRIMARY='{"provider":"groq","endpoint":"https://api.groq.com/openai/v1/chat/completions","apiKey":"replace-with-primary-token","models":[{"id":"free/default","upstreamModel":"replace-with-current-free-model-id","contextWindow":65536,"maxOutputTokens":4096,"supports":{"streaming":true,"tools":true,"structuredOutput":false,"vision":false},"tier":"fast","free":true}],"rateLimits":{"dailySafetyBudgetTokens":0,"cooldownMs":900000,"requests":{"limit":1,"windowMs":60000},"maxConcurrent":1,"reservationTtlMs":120000}}'

# A second account for the same provider. It is independently admitted and accounted.
BROKEROUTER_PROVIDER_ACCOUNT_GROQ_BACKUP='{"provider":"groq","endpoint":"https://api.groq.com/openai/v1/chat/completions","apiKey":"replace-with-backup-token","models":[{"id":"free/default","upstreamModel":"replace-with-current-free-model-id","contextWindow":65536,"maxOutputTokens":4096,"supports":{"streaming":true,"tools":true,"structuredOutput":false,"vision":false},"tier":"fast","free":true}],"rateLimits":{"dailySafetyBudgetTokens":0,"cooldownMs":900000,"requests":{"limit":1,"windowMs":60000},"maxConcurrent":1,"reservationTtlMs":120000}}'

# Add more accounts by copying either line and choosing a unique suffix. To disable one
# without deleting it, add "enabled":false to that account's JSON object.
